<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox prefHeight="520" prefWidth="560" spacing="16" style="-fx-background-color: #1c2d49;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.metamorphosis.controller.LojaController">

    <padding><Insets bottom="24" left="28" right="28" top="24" /></padding>

    <Label style="-fx-font-size: 44px;  -fx-font-family: 'm5x7'; -fx-text-fill: #f0c040; -fx-font-weight: bold;" text="🛒 Loja da Layla" />

    <Label style="-fx-font-size: 24px;  -fx-font-family: 'm5x7'; -fx-text-fill: #ccaaff;" text="Troque seus pontos por ajudas contra o monstro Nilipe" />

    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #243b60; -fx-background-radius: 8; -fx-padding: 10 16 10 16;">
        <Label style="-fx-text-fill: #aaaaaa; -fx-font-size: 26px;  -fx-font-family: 'm5x7';" text="Seus pontos:" />
        <Label fx:id="lblPontosAtuais" style="-fx-text-fill: #50fa7b; -fx-font-size: 36px; -fx-font-weight: bold;  -fx-font-family: 'm5x7';" text="0" />
    </HBox>

  
    <VBox spacing="6" style="-fx-background-color: #b9cff2; -fx-background-radius: 10; -fx-border-color: #9b59b6; -fx-border-radius: 10; -fx-padding: 14;">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 20px;" text="⏱️" />
            <VBox spacing="2">
                <Label style="-fx-text-fill: #ffffff; -fx-font-size: 28px; -fx-font-weight: bold;  -fx-font-family: 'm5x7';" text="Tempo Extra" />
                <Label style="-fx-text-fill: #666666; -fx-font-size: 22px;  -fx-font-family: 'm5x7';" text="Adiciona 60 segundos ao cronômetro da fase" />
            </VBox>
            <HBox HBox.hgrow="ALWAYS" />
            <Label style="-fx-text-fill: #f0c040; -fx-font-size: 26px; -fx-font-family: 'm5x7';" text="800 pts" />
        </HBox>
        <Button fx:id="btnComprarTempo" maxWidth="Infinity" onAction="#comprarTempoExtra" style="-fx-background-color: #36558b; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6; -fx-font-size: 24px; -fx-font-family: 'm5x7';" text="Comprar" />
    </VBox>


    <VBox spacing="6" style="-fx-background-color: #b9cff2; -fx-background-radius: 10; -fx-border-color: #9b59b6; -fx-border-radius: 10; -fx-padding: 14;">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 20px;" text="🛡️" />
            <VBox spacing="2">
                <Label style="-fx-text-fill: #ffffff; -fx-font-size: 28px; -fx-font-weight: bold;  -fx-font-family: 'm5x7';" text="Proteção Anti-Nilipe" />
                <Label style="-fx-text-fill: #666666; -fx-font-size: 19px;  -fx-font-family: 'm5x7';" text="Nilipe espera 30s extras antes do próximo roubo" />
            </VBox>
            <HBox HBox.hgrow="ALWAYS" />
            <Label style="-fx-text-fill: #f0c040; -fx-font-size: 26px;  -fx-font-family: 'm5x7';" text="600 pts" />
        </HBox>
        <Button fx:id="btnComprarProtecao" maxWidth="Infinity" onAction="#comprarProtecao" style="-fx-background-color: #36558b; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6; -fx-font-size: 24px; -fx-font-family: 'm5x7';" text="Comprar" />
    </VBox>


    <VBox spacing="6" style="-fx-background-color: #b9cff2; -fx-background-radius: 10; -fx-border-color: #9b59b6; -fx-border-radius: 10; -fx-padding: 14;">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 20px;" text="💡" />
            <VBox spacing="2">
                <Label style="-fx-text-fill: #ffffff; -fx-font-size: 28px; -fx-font-weight: bold;  -fx-font-family: 'm5x7';" text="Dica da Layla" />
                <Label style="-fx-text-fill: #666666; -fx-font-size: 22px;  -fx-font-family: 'm5x7';" text="Revela a próxima combinação que falta" />
            </VBox>
            <HBox HBox.hgrow="ALWAYS" />
            <Label style="-fx-text-fill: #f0c040; -fx-font-size: 26px;  -fx-font-family: 'm5x7';" text="400 pts" />
        </HBox>
        <Button fx:id="btnComprarDica" maxWidth="Infinity" onAction="#comprarDica" style="-fx-background-color: #36558b; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6; -fx-font-size: 24px; -fx-font-family: 'm5x7';" text="Comprar" />
    </VBox>


    <Label fx:id="lblMensagem" style="-fx-text-fill: #50fa7b; -fx-font-size: 24px;  -fx-font-family: 'm5x7';" text="" wrapText="true" />

    <HBox HBox.hgrow="ALWAYS" />

    <Button maxWidth="Infinity" onAction="#fechar" style="-fx-background-color: #333; -fx-text-fill: #ccc;   -fx-font-size: 24px; -fx-cursor: hand; -fx-background-radius: 6; -fx-padding: 8;  -fx-font-family: 'm5x7';" text="Fechar" />
</VBox>

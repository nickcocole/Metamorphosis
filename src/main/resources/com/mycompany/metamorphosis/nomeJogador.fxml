<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0"
      style="-fx-background-color: #1a0a2e;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.metamorphosis.controller.NomeJogadorController">

    <padding><Insets top="40" bottom="40" left="60" right="60"/></padding>

    <Label text="✨ Bem-vindo a Metamorphosis ✨"
           style="-fx-font-size: 22px; -fx-text-fill: #f0c040; -fx-font-weight: bold;"/>

    <Label text="A cigana Layla convoca você para uma missão..."
           style="-fx-font-size: 14px; -fx-text-fill: #ccaaff;"/>

    <Label text="Qual é o seu nome, transmorfo?"
           style="-fx-font-size: 16px; -fx-text-fill: #ffffff;"/>

    <TextField fx:id="txtNome"
               promptText="Digite seu nome"
               maxWidth="300"
               style="-fx-background-color: #2d1b4e; -fx-text-fill: white;
                      -fx-border-color: #9b59b6; -fx-border-radius: 6;
                      -fx-background-radius: 6; -fx-font-size: 14px;"/>

    <Label fx:id="lblErro"
           text=""
           style="-fx-text-fill: #ff6b6b; -fx-font-size: 12px;"
           visible="false"/>

    <Button text="Começar aventura →"
            onAction="#confirmar"
            style="-fx-background-color: #9b59b6; -fx-text-fill: white;
                   -fx-font-size: 14px; -fx-cursor: hand;
                   -fx-background-radius: 8; -fx-padding: 10 30 10 30;"/>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Layout principal da gameplay.
    ┌──────────────── HUD (topo) ─────────────────────────┐
    │  fase | jogador | pontos | btn inventário | btn voltar│
    ├────────────────────────────────────────────────────────┤
    │                                                        │
    │           ÁREA DE DROP (AnchorPane livre)              │
    │    elementos aparecem aqui e são arrastados            │
    │                                                        │
    ├──────────────── DIÁLOGO (base) ────────────────────────┤
    │  [avatar]  texto da cigana/monstro...     [objetivos]  │
    └────────────────────────────────────────────────────────┘
-->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.metamorphosis.controller.GameplayController"
      style="-fx-background-color: #0d0d1a;"
      prefWidth="1280" prefHeight="720">

    <!-- ── HUD ─────────────────────────────────────────── -->
    <HBox fx:id="hud" alignment="CENTER_LEFT" spacing="20"
          style="-fx-background-color: #1a0a2e; -fx-padding: 8 16 8 16;">

        <Label fx:id="lblFase"    text="Fase 1"
               style="-fx-text-fill: #f0c040; -fx-font-size: 15px; -fx-font-weight: bold;"/>
        <Label text="|" style="-fx-text-fill: #555;"/>
        <Label fx:id="lblJogador" text="Jogador"
               style="-fx-text-fill: #ccaaff; -fx-font-size: 13px;"/>
        <Label text="|" style="-fx-text-fill: #555;"/>
        <Label text="Pontos:" style="-fx-text-fill: #aaa; -fx-font-size: 13px;"/>
        <Label fx:id="lblPontos"  text="0"
               style="-fx-text-fill: #50fa7b; -fx-font-size: 15px; -fx-font-weight: bold;"/>

        <!-- Empurra botões para a direita -->
        <HBox HBox.hgrow="ALWAYS"/>

        <Button text="🎒 Inventário" onAction="#abrirInventario"
                style="-fx-background-color: #6c3483; -fx-text-fill: white;
                       -fx-cursor: hand; -fx-background-radius: 6;"/>
        <Button text="← Menu"        onAction="#voltar"
                style="-fx-background-color: #333; -fx-text-fill: #ccc;
                       -fx-cursor: hand; -fx-background-radius: 6;"/>
    </HBox>

    <!-- ── ÁREA CENTRAL (drop zone + barra lateral) ────── -->
    <HBox VBox.vgrow="ALWAYS">

        <!-- Área de drag-and-drop -->
        <AnchorPane fx:id="areaJogo" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: #111122;">
            <!-- Os ElementoPanels são adicionados aqui pelo controller -->
        </AnchorPane>

        <!-- Barra lateral: itens disponíveis para arrastar para a área -->
        <VBox fx:id="barraLateral" spacing="6" alignment="TOP_CENTER"
              style="-fx-background-color: #1a1a33; -fx-padding: 10;"
              prefWidth="130">
            <Label text="Elementos" style="-fx-text-fill: #aaa; -fx-font-size: 11px;"/>
            <ScrollPane fitToWidth="true" style="-fx-background: transparent;">
                <FlowPane fx:id="painelElementos" vgap="6" hgap="6"
                          prefWrapLength="110" style="-fx-background: transparent;"/>
            </ScrollPane>
        </VBox>
    </HBox>

    <!-- ── PAINEL DE DIÁLOGO (base) ────────────────────── -->
    <HBox fx:id="painelDialogo" spacing="12" alignment="CENTER_LEFT"
          style="-fx-background-color: #120a20; -fx-border-color: #9b59b6;
                 -fx-border-width: 2 0 0 0; -fx-padding: 10 16 10 16;"
          prefHeight="130">

        <ImageView fx:id="imgPersonagem" fitWidth="80" fitHeight="80"
                   preserveRatio="true"/>

        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label fx:id="lblNomePersonagem" text="Layla"
                   style="-fx-text-fill: #f0c040; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <Label fx:id="lblDialogo"
                   text=""
                   wrapText="true"
                   style="-fx-text-fill: #eeeeee; -fx-font-size: 13px;"
                   prefWidth="700"/>
        </VBox>

        <!-- Painel de objetivos da fase -->
        <VBox spacing="4" alignment="TOP_LEFT" minWidth="220">
            <Label text="🎯 Objetivos:"
                   style="-fx-text-fill: #f0c040; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            <VBox fx:id="painelObjetivos" spacing="2"/>
        </VBox>
    </HBox>

    <!-- ── OVERLAY DE COMBINAÇÃO (aparece ao combinar) ── -->
    <StackPane fx:id="overlayCombo"
               style="-fx-background-color: rgba(0,0,0,0.75);"
               visible="false" managed="false"
               prefWidth="1280" prefHeight="720">
        <VBox alignment="CENTER" spacing="10">
            <Label fx:id="lblComboTitulo" text="✨ Novo elemento!"
                   style="-fx-font-size: 26px; -fx-text-fill: #f0c040; -fx-font-weight: bold;"/>
            <ImageView fx:id="imgComboIcone" fitWidth="90" fitHeight="90" preserveRatio="true"/>
            <Label fx:id="lblComboNome" text=""
                   style="-fx-font-size: 20px; -fx-text-fill: white;"/>
            <Label fx:id="lblComboPontos" text="+500"
                   style="-fx-font-size: 16px; -fx-text-fill: #50fa7b;"/>
        </VBox>
    </StackPane>
</VBox>
